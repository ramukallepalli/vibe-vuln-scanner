{
  "manifest_version": 3,
  "name": "Vibe Vulnerability Scanner",
  "version": "1.2.0",
  "description": "Scans web applications for security vulnerabilities",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "tabs",
    "webRequest",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/scanner.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  }
}
