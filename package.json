{
  "name": "vibe-vuln-scanner",
  "version": "1.3.0",
  "description": "Chrome extension to scan web applications for security vulnerabilities using CISA KEV catalog and NVD verification",
  "homepage": "https://github.com/ramukallepalli/vibe-vuln-scanner",
  "bugs": {
    "url": "https://github.com/ramukallepalli/vibe-vuln-scanner/issues"
  },
  "scripts": {
    "lint": "eslint 'src/**/*.js'",
    "lint:fix": "eslint 'src/**/*.js' --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "web-ext run --source-dir .",
    "package": "web-ext build --source-dir . --artifacts-dir dist --overwrite-dest"
  },
  "keywords": [
    "chrome-extension",
    "security",
    "vulnerability-scanner",
    "cisa-kev",
    "xss",
    "csp",
    "security-headers",
    "nvd",
    "cve",
    "manifest-v3",
    "web-security",
    "security-audit",
    "penetration-testing",
    "security-tools",
    "chrome-security",
    "vulnerability-detection"
  ],
  "author": "Ramu Kallepalli <ramu.kallepalli@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramukallepalli/vibe-vuln-scanner.git"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "web-ext": "^7.11.0"
  }
}
